# ─────────────────────────────────────────────
#  ENVIRONMENT  :  local | prod
# ─────────────────────────────────────────────
APP_ENV=local

# ─────────────────────────────────────────────
#  LLM CONFIG
#  local  → Gemma 2B via Ollama (on-premise, zero data leak)
#  prod   → Gemini 1.5 Flash via Google Cloud
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Use host.docker.internal (not localhost) so Docker containers can reach Ollama on the host machine
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:4b

# ─────────────────────────────────────────────
#  DATABASE (PostgreSQL)
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kyc_agent
DB_USER=kyc_user
DB_PASSWORD=kyc_secret

# ─────────────────────────────────────────────
#  KYC CONFIG
# ─────────────────────────────────────────────
# Score thresholds (0-100)
KYC_AUTO_APPROVE_THRESHOLD=95
KYC_AUTO_REJECT_THRESHOLD=70

# Face match minimum confidence (%)
FACE_MATCH_MIN_CONFIDENCE=85.0

# ─────────────────────────────────────────────
#  SMS (mock in local, Africa's Talking in prod)
# ─────────────────────────────────────────────
SMS_PROVIDER=mock
AFRICASTALKING_USERNAME=your_username
AFRICASTALKING_API_KEY=your_api_key
AFRICASTALKING_SENDER_ID=KYC-AGENT

# ─────────────────────────────────────────────
#  A2A — Human Review Agent endpoint
# ─────────────────────────────────────────────
HUMAN_REVIEW_AGENT_URL=http://localhost:8001
